/// Estate configuration-state breakdown for the "Estate configuration state"
/// donut. Unions the MDE-discovered estate (DeviceHealth) with legacy-AV-only
/// devices (in the ingested legacy AV/EDR list but never discovered by MDE) so the
/// donut can distinguish, among not-onboarded devices: discovered-and-in-legacy-AV
/// (shown red) versus legacy-AV-only (shown grey). DeviceHealth is left untouched
/// so onboarding / health KPIs are not distorted by the injected legacy AV rows.
table EstateConfigState

	column ConfigStateLabel
		dataType: string
		summarizeBy: none
		sourceColumn: [ConfigStateLabel]

	column DeviceKey
		dataType: string
		summarizeBy: none
		sourceColumn: [DeviceKey]

	measure 'Config State Devices' = COUNTROWS(EstateConfigState) + 0
		formatString: 0

	/// Not-onboarded devices that MDE has discovered AND that appear in the
	/// ingested legacy AV/EDR list (the RED donut slice / migration-ready backlog).
	measure 'Not Onboarded In Legacy AV' = CALCULATE(COUNTROWS(EstateConfigState), EstateConfigState[ConfigStateLabel] = "Not onboarded - discovered & in legacy AV") + 0
		formatString: 0

	/// Devices present only in the ingested legacy AV/EDR list and never discovered by
	/// MDE (the GREY donut slice) - blind spots MDE software inventory misses.
	measure 'Legacy AV Only Devices' = CALCULATE(COUNTROWS(EstateConfigState), EstateConfigState[ConfigStateLabel] = "Legacy AV only - not discovered") + 0
		formatString: 0

	partition EstateConfigState = calculated
		mode: import
		source =
				VAR MatchedIds =
				    CALCULATETABLE(
				        DISTINCT(LegacyAvMigration[DeviceId]),
				        LegacyAvMigration[DeviceId] <> ""
				    )
				VAR Mde =
				    SELECTCOLUMNS(
				        DeviceHealth,
				        "ConfigStateLabel",
				            SWITCH(
				                TRUE(),
				                DeviceHealth[OnboardingStatus] = "Onboarded"
				                    && DeviceHealth[LegacyAvInstalled] = "No"
				                    && DeviceHealth[Healthy] = "Healthy",
				                    "Fully migrated & configured",
				                DeviceHealth[OnboardingStatus] = "Onboarded",
				                    "Onboarded - needs attention",
				                DeviceHealth[DeviceId] IN MatchedIds,
				                    "Not onboarded - discovered & in legacy AV",
				                "Not onboarded (backlog)"
				            ),
				        "DeviceKey", DeviceHealth[DeviceId]
				    )
				VAR LegacyOnly =
				    SELECTCOLUMNS(
				        FILTER(
				            LegacyAvMigration,
				            LegacyAvMigration[MigrationStatus] = "Not found in Defender"
				        ),
				        "ConfigStateLabel", "Legacy AV only - not discovered",
				        "DeviceKey", LegacyAvMigration[LegacyId]
				    )
				RETURN
				    UNION(Mde, LegacyOnly)
