{
  "name": "MigrationTheme",
  "dataColors": [
    "#0F6CBD",
    "#00B7C3",
    "#107C10",
    "#F2A600",
    "#D13438",
    "#5C2D91",
    "#0099BC",
    "#498205",
    "#C239B3",
    "#004E8C",
    "#E3008C",
    "#8A8886"
  ],
  "background": "#FFFFFF",
  "foreground": "#1B2A41",
  "tableAccent": "#0F6CBD",
  "good": "#107C10",
  "neutral": "#F2A600",
  "bad": "#D13438",
  "maximum": "#0F6CBD",
  "center": "#F2A600",
  "minimum": "#D8ECFF",
  "null": "#8A8886",
  "textClasses": {
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 32,
      "color": "#0F3D5E"
    },
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 13,
      "color": "#1B3A57"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#1B3A57"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#323130"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "visualHeader": [
          {
            "show": false
          }
        ],
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#DCE6F2"
              }
            },
            "radius": 12
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "angle": 135,
            "color": {
              "solid": {
                "color": "#0B1E3D"
              }
            },
            "position": "Outer",
            "preset": "Custom",
            "shadowBlur": 18,
            "shadowDistance": 2,
            "shadowSpread": 0,
            "transparency": 86
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#1B3A57"
              }
            },
            "fontSize": 13,
            "bold": true,
            "alignment": "left"
          }
        ],
        "categoryAxis": [
          {
            "showAxisTitle": false,
            "fontSize": 10,
            "labelColor": {
              "solid": {
                "color": "#5B6B7F"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "showAxisTitle": false,
            "fontSize": 10,
            "labelColor": {
              "solid": {
                "color": "#5B6B7F"
              }
            },
            "gridlineColor": {
              "solid": {
                "color": "#EDF2F8"
              }
            }
          }
        ],
        "labels": [
          {
            "fontSize": 10
          }
        ],
        "legend": [
          {
            "fontSize": 10,
            "showTitle": false,
            "labelColor": {
              "solid": {
                "color": "#5B6B7F"
              }
            }
          }
        ]
      }
    },
    "card": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "labels": [
          {
            "fontSize": 30,
            "color": {
              "solid": {
                "color": "#0F3D5E"
              }
            }
          }
        ],
        "categoryLabels": [
          {
            "fontSize": 10,
            "color": {
              "solid": {
                "color": "#5B6B7F"
              }
            }
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#EDF2F8"
              }
            },
            "gridHorizontalWeight": 1,
            "rowPadding": 4,
            "outlineColor": {
              "solid": {
                "color": "#DCE6F2"
              }
            },
            "outlineWeight": 1,
            "textSize": 10
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#1B3A57"
              }
            },
            "backColor": {
              "solid": {
                "color": "#F4F8FD"
              }
            },
            "bold": true,
            "fontSize": 10,
            "wordWrap": true
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#1B2A41"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#1B2A41"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#FAFCFE"
              }
            },
            "fontSize": 10
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#EDF2F8"
              }
            },
            "rowPadding": 4,
            "textSize": 10
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#1B3A57"
              }
            },
            "backColor": {
              "solid": {
                "color": "#F4F8FD"
              }
            },
            "bold": true,
            "fontSize": 10
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "fontColor": {
              "solid": {
                "color": "#1B3A57"
              }
            },
            "fontSize": 11,
            "bold": true
          }
        ],
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#323130"
              }
            },
            "fontSize": 10
          }
        ]
      }
    },
    "pieChart": {
      "*": {
        "labels": [
          {
            "show": true,
            "labelStyle": "Percent of total",
            "fontSize": 10
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "Bottom",
            "fontSize": 10
          }
        ]
      }
    },
    "donutChart": {
      "*": {
        "labels": [
          {
            "show": true,
            "labelStyle": "Percent of total",
            "fontSize": 10
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "Bottom",
            "fontSize": 10
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#EEF3FA"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#0B1E3D"
              }
            },
            "transparency": 0
          }
        ]
      }
    }
  }
}
